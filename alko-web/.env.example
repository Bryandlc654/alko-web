# Copia este archivo a .env (local) y cárgalo igual en Render › Environment. Nunca subas valores reales a git.

# --- WordPress (contenido y Fluent Forms) ---
# URL base de WordPress, sin barra final.
WP_API_URL=https://tu-wordpress.com
# Ids de los formularios (WordPress › Fluent Forms). Si no se definen se usan 3 (rápido) y 4 (proyecto).
FLUENTFORM_QUICK_ID=3
FLUENTFORM_PROJECT_ID=4

# --- Base de datos MySQL del panel (obligatorias) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Sesión del panel /admin (obligatoria, mínimo 32 caracteres) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=

# --- Sitio y asistente ---
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Imágenes subidas desde el panel ---
# Con GITHUB_TOKEN se guardan en la rama GITHUB_MEDIA_BRANCH del repositorio; sin él, en public/uploads (solo desarrollo).
GITHUB_TOKEN=
GITHUB_REPO=usuario/repositorio
GITHUB_MEDIA_BRANCH=media

# --- Primer acceso al panel (usuario admin). Solo si aún no tiene contraseña guardada; mínimo 12 caracteres. ---
ADMIN_INITIAL_PASSWORD=
