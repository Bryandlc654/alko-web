# URL base de WordPress (sin barra final). Ejemplo: https://cms.tudominio.com
WP_API_URL=https://tu-wordpress.com

# Clave API de OpenAI para el Asistente Virtual
OPENAI_API_KEY=tu_openai_api_key_aqui

# Modelo de OpenAI opcional (por defecto gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- Formularios de contacto (se guardan en Fluent Forms, dentro de WordPress) ---
# Usan WP_API_URL. Los avisos por correo se configuran en Fluent Forms. Ids de los formularios
# (WordPress > Fluent Forms); si no se definen se usan 3 (rápido) y 4 (proyecto).
# FLUENTFORM_QUICK_ID=3
# FLUENTFORM_PROJECT_ID=4
