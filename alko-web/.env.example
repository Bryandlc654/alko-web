# URL base de WordPress (sin barra final). Ejemplo: https://cms.tudominio.com
WP_API_URL=https://tu-wordpress.com

# Clave API de OpenAI para el Asistente Virtual
OPENAI_API_KEY=tu_openai_api_key_aqui

# Modelo de OpenAI opcional (por defecto gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- Formulario «Cuéntanos tu proyecto» (envía el correo con los planos adjuntos) ---
# Servidor SMTP de salida: el del correo de tu dominio (p. ej. smtp.hostinger.com, puerto 465)
# o el de cualquier proveedor. Sin estas cuatro variables el formulario avisa de que el envío
# no está disponible y ofrece WhatsApp y correo.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=465
SMTP_USER=web@tudominio.com
SMTP_PASS=tu_contrasena_smtp_aqui
# Dónde llegan las solicitudes del formulario
CONTACT_TO_EMAIL=proyectos@tudominio.com
# Opcionales: remitente (por defecto SMTP_USER) y cifrado (por defecto true solo en el puerto 465)
# CONTACT_FROM_EMAIL=web@tudominio.com
# SMTP_SECURE=true
